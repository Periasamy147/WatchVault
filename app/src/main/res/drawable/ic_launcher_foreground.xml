<?xml version="1.0" encoding="utf-8"?>
<!--
  Intentionally empty. The launcher artwork (the gold watch-and-monogram mark, see
  logo.png at the repo root) is fully composed as a single flat image and lives in
  the background layer (drawable-nodpi/ic_launcher_background.png). The adaptive-icon
  foreground layer is kept blank so the system mask clips just that one image, the
  same way a traditional square/round icon would look, without a second overlapping
  layer.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108" />
