<?xml version="1.0" encoding="utf-8"?>
<!--
  Original minimalist wristwatch glyph for WatchVault: a case ring, a crown nub, and
  hour/minute hands meeting at a center pivot. Not derived from any existing app or
  brand mark. Drawn inside the 108x108 adaptive-icon canvas, kept within the ~66dp
  safe zone so it survives circular/squircle/rounded-square system masks.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Crown nub -->
    <path
        android:fillColor="#ECEFF4"
        android:pathData="M78,49 L87,49 L87,59 L78,59 Z" />

    <!-- Watch case ring -->
    <path
        android:strokeColor="#ECEFF4"
        android:strokeWidth="5.5"
        android:fillColor="#00000000"
        android:pathData="M31,54 A23,23 0 1,0 77,54 A23,23 0 1,0 31,54 Z" />

    <!-- Minute hand -->
    <path
        android:strokeColor="#ECEFF4"
        android:strokeWidth="4"
        android:strokeLineCap="round"
        android:fillColor="#00000000"
        android:pathData="M54,54 L67,54" />

    <!-- Hour hand -->
    <path
        android:strokeColor="#ECEFF4"
        android:strokeWidth="4.5"
        android:strokeLineCap="round"
        android:fillColor="#00000000"
        android:pathData="M54,54 L54,39" />

    <!-- Center pivot -->
    <path
        android:fillColor="#ECEFF4"
        android:pathData="M54,50.5 A3.5,3.5 0 1,0 54.01,50.5 Z" />
</vector>
